@page "/books/create"

@using HomeLibrary.AL.Services
@using Microsoft.AspNetCore.Mvc.RazorPages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model BookCreateModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Создание";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <form class="card shadow-sm" method="post">
                <div class="card-header">
                    <h5 class="mb-0">Создание книги</h5>
                </div>
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="card-body">

                    <div class="mb-3">
                        <label asp-for="BookPost.Title" class="form-label">Название</label>
                        <input asp-for="BookPost.Title" class="form-control" />
                        <span asp-validation-for="BookPost.Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="BookPost.Author" class="form-label">Автор</label>
                        <input asp-for="BookPost.Author" class="form-control" />
                        <span asp-validation-for="BookPost.Author" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="BookPost.PublishYear" class="form-label">Год издания</label>
                        <input asp-for="BookPost.PublishYear" type="number" class="form-control" />
                        <span asp-validation-for="BookPost.PublishYear" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="BookPost.TableOfContents" class="form-label">Оглавление (XML)</label>
                        <textarea asp-for="BookPost.TableOfContents" class="form-control" rows="6"></textarea>
                    </div>
                </div>

                <div class="card-footer d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                    <a asp-page="Books" class="btn btn-secondary">Назад</a>
                </div>
            </form>
        </div>
    </div>
</div>

@functions {

    public class BookCreateModel : PageModel
    {
        readonly IBookService _bookService;

        public BookCreateModel(
            IBookService bookService)
        {
            _bookService = bookService;
        }

        [BindProperty]
        public BookPostDto BookPost { get; set; } = new();

        public async Task<IActionResult> OnPostAsync()
        {
            if (!ModelState.IsValid)
                return Page();

            try
            {
                _ = await _bookService.CreateAsync(BookPost);
            }
            catch (Exception)
            {
                ModelState.AddModelError("", "An error occurred while saving.");
                return Page();
            }
            return RedirectToPage("Books");
        }
    }
}