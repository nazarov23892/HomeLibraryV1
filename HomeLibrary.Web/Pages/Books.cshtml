@page "/"
@using HomeLibrary.AL.Services

@model BooksModel

@{
    Layout = "_Layout";
}

<div class="container">
    <h1 class="mb-4"> Список книг</h1>

    <form method="get" class="mb-3">
        <div class="input-group">
            <input type="text"
                   name="searchString"
                   class="form-control"
                   placeholder="Поиск по названию, автору, содержанию..."
                   value="@Model.SearchString" />
            <button type="submit" class="btn btn-outline-primary">Найти</button>
            <a asp-page="Books" class="btn btn-outline-secondary">Сброс</a>
        </div>
    </form>

    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
        <a class="btn btn-sm btn-outline-primary" asp-page="BookCreate">
            Добавить книгу
        </a>
    </div>

    @if (!Model.PagedBooks.Items.Any())
    {
        <div class="alert alert-info">Книг пока нет.</div>
    }
    else
    {
        <table class="table table-sm table-bordered table-striped">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Название</th>
                    <th>Автор</th>
                    <th>Год</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model.PagedBooks.Items)
                {
                    <tr>
                        <td>@book.Id</td>
                        <td>@book.Title</td>
                        <td>@book.Author</td>
                        <td>@book.PublishYear</td>
                        <td class="w-25">
                            <a class="btn btn-info btn-sm"
                               asp-page="BookDetails" asp-route-id="@book.Id">Просмотр</a>
                            <a class="btn btn-warning btn-sm"
                               asp-page="BookEdit" asp-route-id="@book.Id">Редактировать</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    <div class="d-flex justify-content-center gap-1 mt-3">
        @{
            int itemPage = 0;
            do
            {
                var i = itemPage + 1;
                <a class="btn btn-sm @(i == Model.PageNo ? "btn-primary" : "btn-outline-primary")"
                   asp-page="Books" asp-route-pageNo="@i" asp-route-searchString="@Model.SearchString">
                    @i
                </a>
                itemPage++;
            } while (itemPage < Model.PagedBooks.TotalPages);
        }
    </div>
</div>
@functions {

    public class BooksModel : PageModel
    {
        const int PerPage = 10;
        readonly IBookService _bookService;

        public BooksModel(IBookService bookService)
        {
            _bookService = bookService;
        }

        [BindProperty(SupportsGet = true)]
        public string? SearchString { get; set; }

        [BindProperty(SupportsGet = true)]
        public int PageNo { get; set; } = 1;

        public PagedListResponseDto<BookListDto> PagedBooks { get; private set; } = new();

        public async Task OnGet(CancellationToken cancellationToken)
        {
            PagedBooks = await _bookService.GetListAsync(
                PageNo, PerPage, SearchString, cancellationToken);
        }
    }
}
