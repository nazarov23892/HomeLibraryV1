@page "/"
@using HomeLibrary.AL.Services

@model BooksModel

@{
    Layout = "_Layout";
}

<div class="container">
    <h1 class="mb-4"> Список книг</h1>

    <form method="get" class="mb-3">
        <div class="input-group">
            <input type="text"
                   name="searchString"
                   class="form-control"
                   placeholder="Поиск по названию, автору, содержанию..."
                   value="@Model.SearchString" />
            <button type="submit" class="btn btn-outline-primary">Найти</button>
            <a asp-page="Books" class="btn btn-outline-secondary">Сброс</a>
        </div>
    </form>

    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
        <a class="btn btn-sm btn-outline-primary" asp-page="BookCreate">
            Добавить книгу
        </a>
    </div>

    @if (!Model.Books.Any())
    {
        <div class="alert alert-info">Книг пока нет.</div>
    }
    else
    {
        <table class="table table-sm table-bordered table-striped">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Название</th>
                    <th>Автор</th>
                    <th>Год</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model.Books)
                {
                    <tr>
                        <td>@book.Id</td>
                        <td>@book.Title</td>
                        <td>@book.Author</td>
                        <td>@book.PublishYear</td>
                        <td>
                            <a class="btn btn-info btn-sm"
                               asp-page="BookDetails" asp-route-id="@book.Id">Просмотр</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
@functions {

    public class BooksModel : PageModel
    {
        readonly IBookService _bookService;
        public IEnumerable<BookListDto> Books { get; private set; } = [];

        public BooksModel(IBookService bookService)
        {
            _bookService = bookService;
        }

        [BindProperty(SupportsGet = true)]
        public string? SearchString { get; set; }

        public async Task OnGet(CancellationToken cancellationToken)
        {
            Books = await _bookService.GetListAsync(SearchString, cancellationToken);
        }
    }
}
