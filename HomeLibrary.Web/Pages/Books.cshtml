@page "/"

@model BooksModel

@{
    Layout = "_Layout.cshtml";
}

<h1 class="mb-4"> Список книг</h1>

@if (!Model.Books.Any())
{
    <div class="alert alert-info">Книг пока нет.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Название</th>
                <th>Автор</th>
                <th>Год</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model.Books)
            {
                <tr>
                    <td>@book.Id</td>
                    <td>@book.Title</td>
                    <td>@book.Author</td>
                    <td>@book.PublishYear</td>
                </tr>
            }
        </tbody>
    </table>
}

@functions {

    public class BooksModel : PageModel
    {
        public List<BookListDto> Books { get; private set; } = new();

        public BooksModel()
        {
            for (var i = 0; i < 10; i++)
            {
                Books.Add(
                    new BookListDto()
                        {
                            Id = 1 + i,
                            Title = $"book-{1 + i}",
                            Author = $"author-{1 + i}",
                            PublishYear = 2000 + i,
                        }
                );
            }
        }
    }
}
